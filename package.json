{
  "name": "meditrack-ai",
  "version": "1.0.0",
  "description": "Intelligent medication reminder agent powered by Mastra AI and integrated with Telex.im",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "medication",
    "reminder",
    "ai",
    "mastra",
    "telex",
    "healthcare"
