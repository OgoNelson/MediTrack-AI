# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/meditrack-ai
MONGODB_TEST_URI=mongodb://localhost:27017/meditrack-ai-test

# Mastra AI Configuration
MASTRA_API_KEY=your_mastra_api_key_here
MASTRA_AGENT_ID=medication-agent

# Telex.im Configuration
TELEX_WEBHOOK_SECRET=your_telex_webhook_secret_here
TELEX_API_BASE_URL=https://api.telex.im

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Scheduler Configuration
SCHEDULER_ENABLED=true
TIMEZONE=UTC

# External Services
WEBHOOK_BASE_URL=https://your-domain.com/webhook